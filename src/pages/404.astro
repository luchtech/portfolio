---
import '../styles/global.css';
import Lucide from '../components/Lucide.astro';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/jpeg" href="/profile.jpeg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="robots" content="noindex" />
    <title>Page not found · James Carlo Luchavez</title>
    <meta name="theme-color" content="#f3f4f1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0f14" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <main class="not-found">
      <p class="not-found-code">404</p>
      <h1>This route doesn't deploy.</h1>
      <p class="lead">There's nothing here — the page you're looking for doesn't exist or moved.</p>
      <a class="btn btn--dark" href="/">
        Back to the homepage
        <Lucide name="arrow-right" size={16} />
      </a>
    </main>
  </body>
</html>
